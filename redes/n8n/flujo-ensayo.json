      "parameters": {
        "jsCode": "// Las piezas con \"lista\": true, con su clave de semana (p. ej. \"matchday-2026-10-19\")\nreturn Object.values($input.first().json.piezas || {})\n  .filter(p => p.lista)\n  .map(pieza => ({ json: { clave: `${pieza.tipo}-${pieza.semana}`, pieza } }));"
      },
