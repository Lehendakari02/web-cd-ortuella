    {
      "parameters": {
        "jsCode": "// Foto del post + petición del texto. La línea «🆔» dice qué pieza es: al responder, el bot la lee\n// de ahí (así no tiene que recordar nada).\nreturn $input.all().map(item => {\n  const p = item.json.pieza;\n  const falta = (p.faltan || []).length ? `\\n⚠️ Ojo, falta: ${p.faltan.join('; ')}` : '';\n  return { json: { foto: p.post,\n    texto: `${p.nombre} lista para publicar ✅${falta}\\n\\n✍️ RESPONDE A ESTA FOTO (mantén pulsado → Responder) con el texto de la publicación.\\n🆔 ${p.tipo}` } };\n});"
      },
      "id": "e155bea2-6b3e-5494-8e98-db03a0b78969",
      "name": "Preparar pregunta",
